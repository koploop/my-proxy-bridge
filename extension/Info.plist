	<string>代理桥需要安装系统扩展以按规则转发应用的网络连接。</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>代理桥需要访问本地网络中的代理服务器。</string>
	<key>NetworkExtension</key>
	<dict>
		<key>NEProviderClasses</key>
		<dict>
			<key>com.apple.networkextension.app-proxy</key>
			<string>$(PRODUCT_MODULE_NAME).AppProxyProvider</string>
			<key>com.apple.networkextension.dns-proxy</key>
			<string>$(PRODUCT_MODULE_NAME).DNSProxyProvider</string>
		</dict>
	</dict>
</dict>
</plist>
