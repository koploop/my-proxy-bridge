// MARK: - Team Configuration
DEVELOPMENT_TEAM = P57F6K6J34
MAC_PROXY_TEAM = P57F6K6J34

// MARK: - Extension Signing
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_ENTITLEMENTS = extension/extensionRelease.entitlements
PRODUCT_BUNDLE_IDENTIFIER = com.commonuse.magic.extension
PRODUCT_MODULE_NAME = com_macproxybridge_client_extension
PROVISIONING_PROFILE_SPECIFIER = macCommonUseExtension
MAC_PROXY_EXT_PROFILE = macCommonUseExtension

// MARK: - Additional Signing Settings
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
ENABLE_HARDENED_RUNTIME = YES

// MARK: - Architecture (Universal Binary: Intel + Apple Silicon)
ARCHS = arm64 x86_64
ONLY_ACTIVE_ARCH = NO
